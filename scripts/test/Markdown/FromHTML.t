use strict;
use warnings;
use utf8;

# core modules

# CPAN modules
use Test2::V0;

# OTOBO modules
use Kernel::System::UnitTest::RegisterOM;    # Set up $Kernel::OM

my $MarkdownObject = $Kernel::OM->Get('Kernel::System::Markdown');

skip_all('HTML::TreeBuilder is not installed') unless $MarkdownObject->IsAvailable( Direction => 'FromHTML' );

# FromHTML() without the needed parameter String
{
    my $Markdown = $MarkdownObject->FromHTML();
    is( $Markdown, undef, 'FromHTML() without String returns undef' );
}

# The generated Markdown is compared exactly, as the converter is part of this package.
my @Tests = (
    {
        Name     => 'empty string',
        HTML     => '',
        Expected => "\n",
    },
    {
        Name     => 'plain text',
        HTML     => 'Just some text',
        Expected => "Just some text\n",
    },
    {
        Name     => 'paragraph with inline formatting',
        HTML     => '<p>Some <em>emphasis</em>, <strong>strong</strong>, <b>bold</b>, <i>italic</i>, <s>struck</s> and <code>code</code>.</p>',
        Expected => "Some *emphasis*, **strong**, **bold**, *italic*, ~~struck~~ and `code`.\n",
    },
    {
        Name     => 'headings',
        HTML     => '<h1>One</h1><p>text</p><h3>Three</h3>',
        Expected => "# One\n\ntext\n\n### Three\n",
    },
    {
        Name     => 'links',
        HTML     => '<p>See <a href="https://otobo.io/">OTOBO</a> or <a href="https://otobo.io/">https://otobo.io/</a> or <a>no href</a>.</p>',
        Expected => "See [OTOBO](https://otobo.io/) or <https://otobo.io/> or no href.\n",
    },
    {
        Name     => 'images',
        HTML     => '<p><img src="https://otobo.io/i.png" alt="pic"> and <img src="data:image/png;base64,AAAA" alt="inline"></p>',
        Expected => "![pic](https://otobo.io/i.png) and inline\n",
    },
    {
        Name     => 'nested lists',
        HTML     => '<ul><li>one</li><li>two<ul><li>nested</li></ul></li></ul><ol><li>first</li><li>second</li></ol>',
        Expected => "- one\n- two\n  - nested\n\n1. first\n2. second\n",
    },
    {
        Name     => 'list item with paragraph, as generated by CKEditor',
        HTML     => '<ul><li><p>item</p></li></ul>',
        Expected => "- item\n",
    },
    {
        Name     => 'table with header row',
        HTML     => '<table><thead><tr><th>A</th><th>B</th></tr></thead><tbody><tr><td>1</td><td>a | b<br>c</td></tr></tbody></table>',
        Expected => "| A | B |\n| --- | --- |\n| 1 | a \\| b c |\n",
    },
    {
        Name     => 'table without header row inside figure, as generated by CKEditor',
        HTML     => '<figure class="table"><table><tbody><tr><td>k</td><td>v</td></tr><tr><td>x</td><td></td></tr></tbody></table></figure>',
        Expected => "| k | v |\n| --- | --- |\n| x |  |\n",
    },
    {
        Name     => 'code block with language',
        HTML     => "<pre><code class=\"language-perl\">my \$x = 1;\nprint \$x;\n</code></pre>",
        Expected => "```perl\nmy \$x = 1;\nprint \$x;\n```\n",
    },
    {
        Name     => 'code block without language keeps markdown characters',
        HTML     => '<pre>a * b _c_</pre>',
        Expected => "```\na * b _c_\n```\n",
    },
    {
        Name     => 'inline code containing a backtick',
        HTML     => '<p>Code <code>a`b</code></p>',
        Expected => "Code ``a`b``\n",
    },
    {
        Name     => 'block quote and horizontal rule',
        HTML     => '<blockquote><p>quoted</p><p>more</p></blockquote><hr><p>after</p>',
        Expected => "> quoted\n>\n> more\n\n---\n\nafter\n",
    },
    {
        Name     => 'line breaks and divs, as in HTML emails',
        HTML     => '<div>Line one<br>line two</div><div>Line three</div>',
        Expected => "Line one\nline two\n\nLine three\n",
    },
    {
        Name     => 'markdown characters in text are escaped',
        HTML     => '<p>5 * 3, a_b, `x`, [y], 1 &lt; 2</p><p>- not a list</p><p>1. not a list</p><p># not a heading</p>',
        Expected => "5 \\* 3, a\\_b, \\`x\\`, \\[y\\], 1 \\< 2\n\n\\- not a list\n\n1\\. not a list\n\n\\# not a heading\n",
    },
    {
        Name     => 'whitespace around bold is moved outside',
        HTML     => '<p>a<strong> b </strong>c</p>',
        Expected => "a **b** c\n",
    },
    {
        Name     => 'task list check boxes',
        HTML     => '<ul><li><input type="checkbox" disabled=""> open</li><li><input type="checkbox" checked="" disabled=""> done</li></ul>',
        Expected => "- [ ] open\n- [x] done\n",
    },
    {
        Name     => 'complete document, head and script are dropped',
        HTML     => '<html><head><title>T</title><style>p{}</style></head><body><p>Grüße</p><script>alert(1)</script></body></html>',
        Expected => "Grüße\n",
    },
    {
        Name     => 'entities are decoded',
        HTML     => '<p>Gr&uuml;&szlig;e &amp; Co</p>',
        Expected => "Grüße & Co\n",
    },
    {
        Name     => 'unknown inline elements are replaced by their content',
        HTML     => '<p><span style="color:red">red</span> <u>under</u> <font size="2">font</font></p>',
        Expected => "red under font\n",
    },
);

for my $Test (@Tests) {
    my $Markdown = $MarkdownObject->FromHTML(
        String => $Test->{HTML},
    );

    is( $Markdown, $Test->{Expected}, "FromHTML() - $Test->{Name}" );
}

# round trip: Markdown -> HTML -> Markdown gives the same Markdown for common constructs
if ( $MarkdownObject->IsAvailable( Direction => 'ToHTML' ) ) {
    my $Original = <<'END_MARKDOWN';
# Heading

Some *emphasis* and **strong** text with `code` and a [link](https://example.com).

- item 1
- item 2
  - nested

| Col A | Col B |
| --- | --- |
| 1 | 2 |

```perl
my $x = 1;
```

> quote

See <https://otobo.io/> and ~~strike~~.
END_MARKDOWN

    my $HTML      = $MarkdownObject->ToHTML( String => $Original );
    my $RoundTrip = $MarkdownObject->FromHTML( String => $HTML );

    is( $RoundTrip, $Original, 'round trip Markdown -> HTML -> Markdown' );
}

done_testing;
